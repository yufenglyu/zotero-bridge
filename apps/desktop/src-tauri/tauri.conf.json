{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zotero Search Bridge",
  "version": "0.1.0",
  "identifier": "com.zsb.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zotero Search Bridge",
        "width": 920,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Zotero Search Bridge",
    "shortDescription": "External fast search and item locator for Zotero",
    "longDescription": "Zotero Search Bridge syncs your Zotero library into a local full-text index and exposes it to Listary, Alfred and Raycast via zotero:// select links.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "Copyright (c) 2026 Zotero Search Bridge contributors",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"]
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": null
    }
  }
}
